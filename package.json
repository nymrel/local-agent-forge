{
  "name": "@nymrel/local-forge",
  "version": "1.0.0",
  "packageManager": "npm@11.19.1",
  "description": "Pre-release local inference adapters, heuristic routing, MCP tools, and measured cost-comparison telemetry for agent workflows",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "local-forge": "./bin/local-forge.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/",
    "bin/local-forge.js",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "RELEASE_READINESS.md",
    "SECURITY.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/src/cli.js",
    "mcp": "node dist/src/cli.js mcp",
    "test": "npm run build && npm run test:node && npm run test:python",
    "test:node": "node --test dist/test/*.test.js",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run test:node && npm run test:python && npm run check:package",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "audit:ci": "npm audit --audit-level=high",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymrel/local-agent-forge.git"
  },
  "keywords": [
    "local-ai",
    "gpu-orchestrator",
    "ollama",
    "vllm",
    "lm-studio",
    "comfyui",
    "whisper",
    "mcp",
    "model-context-protocol",
    "model-router",
    "token-economics",
    "agentic-ai",
    "nymrel"
  ],
  "author": "Nymrel <contact@nymrel.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nymrel/local-agent-forge/issues"
  },
  "homepage": "https://github.com/nymrel/local-agent-forge#readme",
  "engines": {
    "node": ">=22.19 <27",
    "npm": ">=11.5 <12"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "7.0.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
